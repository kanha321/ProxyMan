# ===================================================================
# ProxyMan .gitignore
# Covers C++, CMake, Visual Studio, WinDivert SDK, & Credentials
# ===================================================================

# -------------------------------------------------------------------
# Sensitive Configuration & Credentials (MUST BE IGNORED)
# -------------------------------------------------------------------
*.env
*.secret
*.key

# -------------------------------------------------------------------
# C / C++ / CMake Build Folders & Intermediate Artifacts
# -------------------------------------------------------------------
build/
**/build/
cmake-build-*/
bin/
obj/
out/
x64/
x86/
Release/
Debug/
**/Release/
**/Debug/

# CMake Generated Files
CMakeCache.txt
CMakeFiles/
**/CMakeFiles/
cmake_install.cmake
Makefile

# Visual Studio & MSVC Files
.vs/
*.vcxproj.user
*.vcxproj.fileListAbsolute
*.sln.docstates

# -------------------------------------------------------------------
# Compiled Binaries & Libraries (Except Vendored SDKs)
# -------------------------------------------------------------------
*.exe
*.dll
*.sys
*.lib
*.pdb
*.ilk
*.exp
*.obj
*.o

# Un-ignore vendored WinDivert SDK
!vendor/WinDivert/**

# -------------------------------------------------------------------
# Logs & Temporary Files
# -------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# -------------------------------------------------------------------
# OS & IDE Junk
# -------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
